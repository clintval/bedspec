from collections.abc import Iterator

class Alignment:
    @property
    def ctg(self) -> str: ...
    @property
    def ctg_len(self) -> int: ...
    @property
    def r_st(self) -> int: ...
    @property
    def r_en(self) -> int: ...
    @property
    def q_st(self) -> int: ...
    @property
    def q_en(self) -> int: ...
    @property
    def strand(self) -> int: ...
    @property
    def mapq(self) -> int: ...
    @property
    def cigar(self) -> list[list[int]]: ...
    @property
    def cigar_str(self) -> str: ...
    @property
    def is_primary(self) -> bool: ...

class Aligner:
    def __init__(self, fn_idx_in: str | None = None, preset: str | None = None) -> None: ...
    def map(self, seq: str, seq2: str | None = None) -> Iterator[Alignment]: ...
