from collections.abc import Iterator

class Variant:
    @property
    def CHROM(self) -> str: ...
    @property
    def POS(self) -> int: ...
    @property
    def start(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def REF(self) -> str: ...
    @property
    def ALT(self) -> list[str]: ...

class VCF:
    def __init__(
        self, fname: str, mode: str = "r", gts012: bool = False, lazy: bool = False
    ) -> None: ...
    def __iter__(self) -> Iterator[Variant]: ...
